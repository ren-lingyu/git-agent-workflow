cabal-version: 3.0
name: gaw-differential-harness
version: 0.1.0.0
build-type: Simple

executable git-gaw-differential
  main-is: Differential.hs
  hs-source-dirs: test
  build-depends:
      base >=4.16 && <5
    , bytestring
    , directory
    , filepath
    , process
    , unix
  default-language: Haskell2010
  ghc-options: -Wall
